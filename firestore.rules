rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidFreeFireUid(uid) {
      return uid is string && uid.matches('^[0-9]{8,12}$');
    }

    function isValidUtr(utr) {
      return utr is string && utr.matches('^[A-Z0-9]{10,22}$');
    }

    function isValidPlayerProfile(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.fullName is string &&
             data.fullName.size() >= 3 &&
             data.fullName.size() <= 80 &&
             data.phone is string &&
             data.phone.matches('^[0-9]{10}$') &&
             isValidFreeFireUid(data.freeFireUid) &&
             data.freeFireIgn is string &&
             data.freeFireIgn.size() >= 2 &&
             data.freeFireIgn.size() <= 30 &&
             data.termsAccepted is bool &&
             data.termsAccepted == true &&
             data.termsVersion is string &&
             data.termsVersion.size() >= 2 &&
             data.termsVersion.size() <= 32 &&
             data.verificationMethod is string &&
             data.verificationMethod.size() >= 2 &&
             data.verificationMethod.size() <= 40 &&
             (!('level' in data) || (data.level is int && data.level >= 1 && data.level <= 999)) &&
             (!('xp' in data) || (data.xp is int && data.xp >= 0 && data.xp <= 1000000)) &&
             (!('points' in data) || (data.points is int && data.points >= 0 && data.points <= 1000000)) &&
             (!('totalTournaments' in data) || (data.totalTournaments is int && data.totalTournaments >= 0 && data.totalTournaments <= 100000)) &&
             (!('totalKills' in data) || (data.totalKills is int && data.totalKills >= 0 && data.totalKills <= 1000000)) &&
             (!('booyahs' in data) || (data.booyahs is int && data.booyahs >= 0 && data.booyahs <= 100000)) &&
             (!('avatarIndex' in data) || (data.avatarIndex is int && data.avatarIndex >= 0 && data.avatarIndex <= 3)) &&
             (!('squadName' in data) || (data.squadName is string && data.squadName.size() <= 40)) &&
             (!('squadTag' in data) || (data.squadTag is string && data.squadTag.size() <= 10)) &&
             (!('squadUids' in data) || (data.squadUids is list && data.squadUids.size() <= 4 && (data.squadUids.size() == 0 || data.squadUids[0] is string))) &&
             (!('lastDailySpinDate' in data) || (data.lastDailySpinDate is string && data.lastDailySpinDate.size() <= 20)) &&
             (!('lastDailySpinAt' in data) || data.lastDailySpinAt == null || data.lastDailySpinAt is timestamp) &&
             (!('referralCode' in data) || (data.referralCode is string && data.referralCode.size() <= 24)) &&
             (!('walletDeposit' in data) || (data.walletDeposit is int && data.walletDeposit >= 0 && data.walletDeposit <= 10000000)) &&
             (!('walletWinning' in data) || (data.walletWinning is int && data.walletWinning >= 0 && data.walletWinning <= 10000000)) &&
             (!('lastApprovedUtr' in data) || (data.lastApprovedUtr is string && data.lastApprovedUtr.size() <= 32)) &&
             (!('trustScore' in data) || (data.trustScore is int && data.trustScore >= 0 && data.trustScore <= 100)) &&
             (!('kycStatus' in data) || (data.kycStatus is string && data.kycStatus in ['Pending', 'Verified', 'Under Review'])) &&
             (!('fcmToken' in data) || (data.fcmToken is string && data.fcmToken.size() <= 512));
    }

    function isValidRegistration(data, userId, tournamentId) {
      return data.userId is string &&
             data.userId == userId &&
             data.tournamentId is string &&
             data.tournamentId == tournamentId &&
             data.tournamentTitle is string &&
             data.tournamentTitle.size() >= 2 &&
             data.tournamentTitle.size() <= 100 &&
             data.mode is string &&
             data.mode.size() >= 2 &&
             data.mode.size() <= 30 &&
             data.slotNumber is int &&
             data.slotNumber >= 1 &&
             data.slotNumber <= 200 &&
             isValidFreeFireUid(data.captainUid) &&
             data.captainIgn is string &&
             data.captainIgn.size() >= 2 &&
             data.captainIgn.size() <= 30 &&
             (!('mapName' in data) || (data.mapName is string && data.mapName.size() <= 30)) &&
             (!('dateTimeLabel' in data) || (data.dateTimeLabel is string && data.dateTimeLabel.size() <= 40)) &&
             (!('teammateUids' in data) || (data.teammateUids is list && data.teammateUids.size() <= 4 && (data.teammateUids.size() == 0 || data.teammateUids[0] is string))) &&
             (!('screenshotSubmitted' in data) || data.screenshotSubmitted is bool) &&
             (!('submittedKills' in data) || (data.submittedKills is int && data.submittedKills >= 0 && data.submittedKills <= 100)) &&
             (!('screenshotUri' in data) || (data.screenshotUri is string && data.screenshotUri.size() <= 500)) &&
             (!('resultStatus' in data) || (data.resultStatus is string && data.resultStatus.size() <= 32));
    }

    function isValidTournamentParticipant(data, participantId, tournamentId) {
      return data.userId is string &&
             data.userId == participantId &&
             data.tournamentId is string &&
             data.tournamentId == tournamentId &&
             data.slotNumber is int &&
             data.slotNumber >= 1 &&
             data.slotNumber <= 200 &&
             data.captainIgn is string &&
             data.captainIgn.size() >= 2 &&
             data.captainIgn.size() <= 30 &&
             isValidFreeFireUid(data.captainUid) &&
             (!('squadTag' in data) || (data.squadTag is string && data.squadTag.size() <= 10)) &&
             (!('avatarIndex' in data) || (data.avatarIndex is int && data.avatarIndex >= 0 && data.avatarIndex <= 3)) &&
             (!('teammateUids' in data) || (data.teammateUids is list && data.teammateUids.size() <= 4 && (data.teammateUids.size() == 0 || data.teammateUids[0] is string)));
    }

    function isValidNotification(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.title is string &&
             data.title.size() >= 2 &&
             data.title.size() <= 100 &&
             data.body is string &&
             data.body.size() >= 2 &&
             data.body.size() <= 300 &&
             data.isRead is bool &&
             (!('category' in data) || (data.category is string && data.category.size() <= 32));
    }

    function isValidTransaction(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.title is string &&
             data.title.size() >= 2 &&
             data.title.size() <= 100 &&
             data.category is string &&
             data.category.size() >= 2 &&
             data.category.size() <= 32 &&
             data.amount is int &&
             data.amount >= 0 &&
             data.amount <= 10000000 &&
             data.isCredit is bool &&
             data.status is string &&
             data.status.size() >= 2 &&
             data.status.size() <= 32;
    }

    function isValidSpinHistoryEntry(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.dateKey is string &&
             data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             data.outcomeLabel is string &&
             data.outcomeLabel in ['No Prize', 'One More Time', '1 Point', '2 Points'] &&
             data.pointsWon is int &&
             data.pointsWon >= 0 &&
             data.pointsWon <= 2 &&
             data.isRetry is bool;
    }

    function isValidTournament(data) {
      return data.title is string &&
             data.title.size() >= 3 &&
             data.title.size() <= 100 &&
             data.mode is string &&
             data.mode.size() >= 2 &&
             data.mode.size() <= 30 &&
             data.mapName is string &&
             data.mapName.size() >= 2 &&
             data.mapName.size() <= 30 &&
             data.dateTimeLabel is string &&
             data.dateTimeLabel.size() >= 2 &&
             data.dateTimeLabel.size() <= 50 &&
             data.status in ['upcoming', 'live', 'completed'] &&
             data.entryFee is int && data.entryFee >= 0 && data.entryFee <= 10000 &&
             data.prizePool is int && data.prizePool >= 0 && data.prizePool <= 1000000 &&
             data.perKill is int && data.perKill >= 0 && data.perKill <= 1000 &&
             data.maxSlots is int && data.maxSlots >= 2 && data.maxSlots <= 200 &&
             data.filledSlots is int && data.filledSlots >= 0 && data.filledSlots <= data.maxSlots &&
             (!('prizeFirst' in data) || (data.prizeFirst is int && data.prizeFirst >= 0)) &&
             (!('prizeSecond' in data) || (data.prizeSecond is int && data.prizeSecond >= 0)) &&
             (!('prizeThird' in data) || (data.prizeThird is int && data.prizeThird >= 0)) &&
             (!('slotUnitLabel' in data) || (data.slotUnitLabel is string && data.slotUnitLabel.size() <= 20)) &&
             (!('rulesSummary' in data) || (data.rulesSummary is string && data.rulesSummary.size() <= 500)) &&
             (!('roomId' in data) || (data.roomId is string && data.roomId.size() <= 32)) &&
             (!('roomPassword' in data) || (data.roomPassword is string && data.roomPassword.size() <= 32)) &&
             (!('roomUnlocked' in data) || data.roomUnlocked is bool) &&
             (!('resultsPublished' in data) || data.resultsPublished is bool) &&
             (!('mvpIgn' in data) || (data.mvpIgn is string && data.mvpIgn.size() <= 40));
    }

    function isValidLeaderboardEntry(data) {
      return data.ign is string &&
             data.ign.size() >= 2 &&
             data.ign.size() <= 30 &&
             data.kills is int && data.kills >= 0 && data.kills <= 1000000 &&
             data.booyahs is int && data.booyahs >= 0 && data.booyahs <= 100000 &&
             data.winningsInr is int && data.winningsInr >= 0 && data.winningsInr <= 10000000 &&
             (!('avatarIndex' in data) || (data.avatarIndex is int && data.avatarIndex >= 0 && data.avatarIndex <= 3));
    }

    function isValidDepositRequest(data, utr) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             isValidUtr(utr) &&
             data.utr is string &&
             data.utr == utr &&
             data.upiId is string &&
             data.upiId == '7378633612@fam' &&
             data.amount is int &&
             data.amount >= 10 &&
             data.amount <= 500 &&
             data.status is string &&
             data.status in ['pending', 'approved', 'rejected'] &&
             data.credited is bool &&
             (!('userIgn' in data) || (data.userIgn is string && data.userIgn.size() <= 40)) &&
             (!('userPhone' in data) || (data.userPhone is string && data.userPhone.size() <= 20)) &&
             (!('userEmail' in data) || (data.userEmail is string && data.userEmail.size() <= 120)) &&
             (!('adminNote' in data) || (data.adminNote is string && data.adminNote.size() <= 300));
    }

    function isValidWithdrawalRequest(data, requestId) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             isValidId(requestId) &&
             data.fullName is string &&
             data.fullName.size() >= 3 &&
             data.fullName.size() <= 80 &&
             isValidFreeFireUid(data.freeFireUid) &&
             data.upiId is string &&
             data.upiId.size() >= 5 &&
             data.upiId.size() <= 80 &&
             data.amount is int &&
             data.amount >= 50 &&
             data.amount <= 10000000 &&
             data.selfieBase64 is string &&
             data.selfieBase64.size() >= 100 &&
             data.selfieBase64.size() <= 350000 &&
             data.status is string &&
             data.status in ['pending', 'paid', 'rejected'] &&
             (!('freeFireIgn' in data) || (data.freeFireIgn is string && data.freeFireIgn.size() <= 30)) &&
             (!('userPhone' in data) || (data.userPhone is string && data.userPhone.size() <= 20)) &&
             (!('userEmail' in data) || (data.userEmail is string && data.userEmail.size() <= 120)) &&
             (!('adminNote' in data) || (data.adminNote is string && data.adminNote.size() <= 300));
    }

    function isSpinCooldownElapsed() {
      let prevSpin = existing().get('lastDailySpinAt', null);
      return prevSpin == null || request.time >= prevSpin + duration.value(24, 'h');
    }

    function isDepositDocApproved(userId, depPath) {
      let dep = get(depPath).data;
      return dep.userId == userId &&
             dep.status == 'approved' &&
             dep.credited == false &&
             getAfter(depPath).data.credited == true &&
             incoming().walletDeposit == existing().get('walletDeposit', 0) + dep.amount;
    }

    function isValidApprovedDepositDoc(userId, utr) {
      let depPath = /databases/$(database)/documents/depositRequests/$(utr);
      return exists(depPath) && isDepositDocApproved(userId, depPath);
    }

    function isValidDepositClaim(userId) {
      return 'lastApprovedUtr' in incoming() &&
             isValidUtr(incoming().lastApprovedUtr) &&
             incoming().lastApprovedUtr != existing().get('lastApprovedUtr', '') &&
             isValidApprovedDepositDoc(userId, incoming().lastApprovedUtr);
    }

    function matchesVerifiedUserStats(userId) {
      let u = get(/databases/$(database)/documents/users/$(userId)).data;
      return incoming().ign == u.freeFireIgn &&
             incoming().kills == u.get('totalKills', 0) &&
             incoming().booyahs == u.get('booyahs', 0) &&
             incoming().winningsInr == u.get('walletWinning', 0);
    }

    function isUserRestricted(data) {
      let st = data.get('accountStatus', 'active');
      return st == 'banned' ||
             (st == 'suspended' &&
              (data.get('suspendedUntil', null) == null || request.time < data.suspendedUntil));
    }

    function isCallerActive() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return !exists(userPath) || !isUserRestricted(get(userPath).data);
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().keys().hasAll([
                         'userId', 'fullName', 'phone', 'freeFireUid',
                         'freeFireIgn', 'termsAccepted', 'termsVersion',
                         'verificationMethod', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'fullName', 'phone', 'freeFireUid',
                         'freeFireIgn', 'termsAccepted', 'termsVersion',
                         'verificationMethod', 'level', 'xp', 'points',
                         'totalTournaments', 'totalKills', 'booyahs', 'avatarIndex',
                         'squadName', 'squadTag', 'squadUids', 'lastDailySpinDate',
                         'lastDailySpinAt', 'referralCode', 'walletDeposit', 'walletWinning',
                         'lastApprovedUtr', 'trustScore', 'kycStatus', 'fcmToken',
                         'accountStatus', 'banReason', 'suspendedUntil', 'bannedAt', 'bannedBy',
                         'createdAt', 'updatedAt'
                       ]) &&
                       (!('points' in incoming()) || incoming().points == 0) &&
                       (!('xp' in incoming()) || incoming().xp == 0) &&
                       (!('totalKills' in incoming()) || incoming().totalKills == 0) &&
                       (!('booyahs' in incoming()) || incoming().booyahs == 0) &&
                       (!('walletDeposit' in incoming()) || incoming().walletDeposit == 0) &&
                       (!('walletWinning' in incoming()) || incoming().walletWinning == 0) &&
                       (!('lastDailySpinAt' in incoming()) || incoming().lastDailySpinAt == null) &&
                       (!('accountStatus' in incoming()) || incoming().accountStatus == 'active') &&
                       (!('banReason' in incoming()) || incoming().banReason == '') &&
                       (!('suspendedUntil' in incoming()) || incoming().suspendedUntil == null) &&
                       (!('bannedAt' in incoming()) || incoming().bannedAt == null) &&
                       (!('bannedBy' in incoming()) || incoming().bannedBy == '') &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       isValidPlayerProfile(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       !isUserRestricted(existing()) &&
                       request.resource.data.updatedAt is timestamp &&
                       request.resource.data.updatedAt <= request.time &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'fullName', 'phone', 'freeFireIgn',
                         'level', 'xp', 'points', 'totalTournaments',
                         'totalKills', 'booyahs', 'avatarIndex',
                         'squadName', 'squadTag', 'squadUids',
                         'lastDailySpinDate', 'lastDailySpinAt', 'referralCode',
                         'walletDeposit', 'walletWinning', 'lastApprovedUtr',
                         'trustScore', 'kycStatus', 'fcmToken', 'updatedAt'
                       ]) &&
                       request.resource.data.get('points', 0) <= resource.data.get('points', 0) &&
                       request.resource.data.get('walletWinning', 0) <= resource.data.get('walletWinning', 0) &&
                       request.resource.data.get('totalKills', 0) <= resource.data.get('totalKills', 0) &&
                       request.resource.data.get('booyahs', 0) <= resource.data.get('booyahs', 0) &&
                       (
                         !('lastDailySpinAt' in request.resource.data) ||
                         request.resource.data.lastDailySpinAt == resource.data.get('lastDailySpinAt', null) ||
                         (
                           request.resource.data.lastDailySpinAt == request.time &&
                           isSpinCooldownElapsed()
                         )
                       ) &&
                       (
                         request.resource.data.get('walletDeposit', 0) <= resource.data.get('walletDeposit', 0) ||
                         (
                           request.resource.data.get('walletDeposit', 0) <= resource.data.get('walletDeposit', 0) + 2 &&
                           'lastDailySpinAt' in request.resource.data &&
                           request.resource.data.lastDailySpinAt == request.time &&
                           isSpinCooldownElapsed() &&
                           request.resource.data.get('lastDailySpinDate', '') is string &&
                           request.resource.data.get('lastDailySpinDate', '').matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                         ) ||
                         isValidDepositClaim(userId)
                       ) &&
                       isValidPlayerProfile(request.resource.data);

      allow delete: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       !isUserRestricted(existing());

      match /registrations/{tournamentId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         isCallerActive() &&
                         isValidId(tournamentId) &&
                         request.auth.uid == userId &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp &&
                         incoming().updatedAt <= request.time &&
                         isValidRegistration(incoming(), userId, tournamentId);

        allow update: if isSignedIn() &&
                         isCallerActive() &&
                         isValidId(tournamentId) &&
                         request.auth.uid == userId &&
                         incoming().userId == existing().userId &&
                         incoming().tournamentId == existing().tournamentId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp &&
                         incoming().updatedAt <= request.time &&
                         isValidRegistration(incoming(), userId, tournamentId) &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'screenshotSubmitted', 'submittedKills', 'screenshotUri',
                           'resultStatus', 'updatedAt'
                         ]);

        allow delete: if isSignedIn() && isCallerActive() && request.auth.uid == userId;
      }

      match /notifications/{notifId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         isCallerActive() &&
                         isValidId(notifId) &&
                         request.auth.uid == userId &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time &&
                         isValidNotification(incoming(), userId);

        allow update: if isSignedIn() &&
                         isCallerActive() &&
                         isValidId(notifId) &&
                         request.auth.uid == userId &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidNotification(incoming(), userId) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['isRead']);

        allow delete: if isSignedIn() && isCallerActive() && request.auth.uid == userId;
      }

      match /transactions/{txId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         isCallerActive() &&
                         isValidId(txId) &&
                         request.auth.uid == userId &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time &&
                         isValidTransaction(incoming(), userId);

        allow update: if false;
        allow delete: if isSignedIn() && isCallerActive() && request.auth.uid == userId;
      }

      match /readAdminNotifications/{notifId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;

        allow create, update: if isSignedIn() &&
                                 isCallerActive() &&
                                 isValidId(notifId) &&
                                 request.auth.uid == userId &&
                                 incoming().notifId is string &&
                                 incoming().notifId == notifId &&
                                 incoming().readAt is timestamp &&
                                 incoming().readAt <= request.time;

        allow delete: if isSignedIn() && isCallerActive() && request.auth.uid == userId;
      }

      match /spinHistory/{spinId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         isCallerActive() &&
                         isValidId(spinId) &&
                         request.auth.uid == userId &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time &&
                         isValidSpinHistoryEntry(incoming(), userId);

        allow update: if false;
        allow delete: if isSignedIn() && isCallerActive() && request.auth.uid == userId;
      }
    }

    match /uidLocks/{freeFireUid} {
      allow get: if isSignedIn() && isValidFreeFireUid(freeFireUid);
      allow list: if false;

      allow create: if isSignedIn() &&
                       isCallerActive() &&
                       isValidFreeFireUid(freeFireUid) &&
                       incoming().keys().hasAll(['userId', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'createdAt']) &&
                       incoming().userId is string &&
                       incoming().userId == request.auth.uid &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       !exists(/databases/$(database)/documents/uidLocks/$(freeFireUid));

      allow update: if false;

      allow delete: if isSignedIn() &&
                       isCallerActive() &&
                       isValidFreeFireUid(freeFireUid) &&
                       existing().userId == request.auth.uid;
    }

    match /tournaments/{tournamentId} {
      allow get: if isSignedIn() && isValidId(tournamentId);
      allow list: if isSignedIn();

      allow create: if false;

      allow update: if isSignedIn() &&
                       isCallerActive() &&
                       isValidId(tournamentId) &&
                       isValidTournament(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['filledSlots']) &&
                       incoming().filledSlots == existing().filledSlots + 1 &&
                       incoming().filledSlots <= existing().maxSlots;

      allow delete: if false;

      match /results/{entryId} {
        allow get: if isSignedIn() && isValidId(tournamentId) && isValidId(entryId);
        allow list: if isSignedIn() && isValidId(tournamentId);
        allow create, update, delete: if false;
      }

      match /participants/{participantId} {
        allow get: if isSignedIn() && isValidId(tournamentId) && isValidId(participantId);
        allow list: if isSignedIn() && isValidId(tournamentId);
        allow create: if isSignedIn() &&
                         isCallerActive() &&
                         isValidId(tournamentId) &&
                         participantId == request.auth.uid &&
                         incoming().joinedAt is timestamp &&
                         incoming().joinedAt <= request.time &&
                         isValidTournamentParticipant(incoming(), participantId, tournamentId);
        allow update, delete: if false;
      }
    }

    match /adminNotifications/{notifId} {
      allow get: if isSignedIn() && isValidId(notifId);
      allow list: if isSignedIn();
      allow create, update, delete: if false;
    }

    match /banners/{bannerId} {
      allow get: if isSignedIn() && isValidId(bannerId);
      allow list: if isSignedIn();
      allow create, update, delete: if false;
    }

    match /leaderboard/{entryId} {
      allow get: if isSignedIn() && isValidId(entryId);
      allow list: if isSignedIn();

      allow create, update: if isSignedIn() &&
                               isCallerActive() &&
                               isValidId(entryId) &&
                               entryId == request.auth.uid &&
                               exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                               incoming().updatedAt is timestamp &&
                               incoming().updatedAt <= request.time &&
                               isValidLeaderboardEntry(incoming()) &&
                               matchesVerifiedUserStats(request.auth.uid);

      allow delete: if false;
    }

    match /utrLocks/{utr} {
      allow get: if isSignedIn() && isValidUtr(utr);
      allow list: if false;

      allow create: if isSignedIn() &&
                       isCallerActive() &&
                       isValidUtr(utr) &&
                       incoming().keys().hasAll(['userId', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'createdAt']) &&
                       incoming().userId is string &&
                       incoming().userId == request.auth.uid &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       !exists(/databases/$(database)/documents/utrLocks/$(utr));

      allow update, delete: if false;
    }

    match /depositRequests/{utr} {
      allow get: if isSignedIn() &&
                    isValidUtr(utr) &&
                    (resource == null || existing().userId == request.auth.uid);

      allow list: if isSignedIn() && existing().userId == request.auth.uid;

      allow create: if isSignedIn() &&
                       isCallerActive() &&
                       isValidUtr(utr) &&
                       incoming().status == 'pending' &&
                       incoming().credited == false &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       isValidDepositRequest(incoming(), utr) &&
                       !exists(/databases/$(database)/documents/depositRequests/$(utr)) &&
                       !exists(/databases/$(database)/documents/utrLocks/$(utr));

      allow update: if isSignedIn() &&
                       isCallerActive() &&
                       isValidUtr(utr) &&
                       existing().userId == request.auth.uid &&
                       existing().status == 'approved' &&
                       existing().credited == false &&
                       incoming().credited == true &&
                       incoming().userId == existing().userId &&
                       incoming().utr == existing().utr &&
                       incoming().upiId == existing().upiId &&
                       incoming().amount == existing().amount &&
                       incoming().status == existing().status &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['credited', 'updatedAt']);

      allow delete: if false;
    }

    match /withdrawalRequests/{requestId} {
      allow get: if isSignedIn() &&
                    isValidId(requestId) &&
                    (resource == null || existing().userId == request.auth.uid);

      allow list: if isSignedIn() && existing().userId == request.auth.uid;

      allow create: if isSignedIn() &&
                       isValidId(requestId) &&
                       incoming().status == 'pending' &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       isValidWithdrawalRequest(incoming(), requestId) &&
                       !exists(/databases/$(database)/documents/withdrawalRequests/$(requestId)) &&
                       exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                       !isUserRestricted(get(/databases/$(database)/documents/users/$(request.auth.uid)).data) &&
                       get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('walletWinning', 0) >= incoming().amount &&
                       getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('walletWinning', 0) ==
                         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('walletWinning', 0) - incoming().amount;

      allow update, delete: if false;
    }
  }
}
